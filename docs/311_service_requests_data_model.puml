@startuml
title 311 Service Requests – Star Schema Data Model
left to right direction
skinparam linetype ortho
hide circle


entity "dim_agency" as dim_agency {
  * **agency_key** : INT <<PK>>
  --
  agency_id : VARCHAR
  agency_name : VARCHAR
}

entity "dim_complaint_type" as dim_complaint_type {
  * **complaint_type_key** : INT <<PK>>
  --
  complaint_type : VARCHAR
  descriptor : VARCHAR
}

entity "dim_location" as dim_location {
  * **location_key** : INT <<PK>>
  --
  incident_zip : VARCHAR
  incident_address : VARCHAR
  street_name : VARCHAR
  address_type : VARCHAR
  landmark : VARCHAR
  city : VARCHAR
  police_precinct : VARCHAR
  borough : VARCHAR
  latitude : DECIMAL
  longitude : DECIMAL
}

entity "dim_status" as dim_status {
  * **status_key** : INT <<PK>>
  --
  status : VARCHAR
}

entity "dim_resolution" as dim_resolution {
  * **resolution_key** : INT <<PK>>
  --
  resolution_description : VARCHAR
}

entity "dim_date" as dim_date {
  * **date_key** : INT <<PK>>
  --
  full_date : DATE
  day : INT
  month : INT
  quarter : INT
  year : INT
  day_of_week : VARCHAR
}

entity "fact_complaints" as fact_complaints {
  * **complaint_key** : BIGINT <<PK>>
  --
  * complaint_id : VARCHAR <<NK>>
  * agency_key : INT <<FK>>
  * complaint_type_key : INT <<FK>>
  * location_key : INT <<FK>>
  * status_key : INT <<FK>>
  * resolution_key : INT <<FK>>
  * date_key : INT <<FK>>
  * resolution_date_key : INT <<FK>>
  complaint_count : INT
}



' Relationships

dim_agency ||--o{ fact_complaints
dim_complaint_type ||--o{ fact_complaints
dim_location ||--o{ fact_complaints
dim_status ||--o{ fact_complaints
dim_resolution ||--o{ fact_complaints
dim_date ||--o{ fact_complaints

' Layout hints
dim_agency -[hidden]down- fact_complaints
dim_date -[hidden]up- fact_complaints
dim_complaint_type -[hidden]left- fact_complaints
dim_location -[hidden]right- fact_complaints
fact_complaints -[hidden]down- fact_complaints
dim_status -[hidden]up- fact_complaints
dim_resolution -[hidden]down- fact_complaints


@enduml